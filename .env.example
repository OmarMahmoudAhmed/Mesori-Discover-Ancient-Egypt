# انسخ هذا الملف إلى .env (محلي، غير مُتتبَّع) واملأ القيم.
# كل متغيّر يبدأ بـ VITE_ يُدمَج في كود المتصفح ويصبح علنياً — لذلك لا تضع هنا أي سر.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Client ID من Google Cloud (OAuth client من نوع "Web application").
# معرّف عام وليس سراً. يُستخدم لتسجيل الدخول الأصلي بجوجل داخل تطبيق Android.
VITE_GOOGLE_WEB_CLIENT_ID=

# ------------------------------------------------------------------
# تحذير: مفتاح service_role يتجاوز كل صلاحيات RLS.
#  - لا تضعه أبداً في هذا الملف ولا في git ولا في Vercel.
#  - لا تُسمّه بأي اسم يبدأ بـ VITE_.
#  - مكانه الوحيد: ملف .env المحلي على جهازك، ويُقرأ فقط من scripts/seed.js:
#      SUPABASE_SERVICE_ROLE_KEY=
# ------------------------------------------------------------------
