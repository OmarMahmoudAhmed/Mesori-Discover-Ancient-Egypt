@@ -0,0 +1,98 @@
+import React, { useEffect, useState } from 'react';
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import { render, act } from '@testing-library/react';
+
+/*
+ * =====================================================
+ * إعادة إنتاج معزولة لنمط useEffect بتاع مؤقّت إجابة
+ * البوت في VsMatchPage.jsx (السطور ~210-231)، لإثبات/نفي
+ * فرضية: هل تغيير phase (لما اللاعب الإنسان يجاوب) بيلغي
+ * مؤقّت البوت المُجدوَل مسبقاً من غير ما يعيد جدولته؟
+ * =====================================================
+ */
+
+function BotTimerRepro({ phase, questionIndex, opponentAnswered, onBotAnswer }) {
+  useEffect(() => {
+    if (phase !== 'question') return;
+    if (opponentAnswered) return;
+
+    const timer = setTimeout(() => {
+      onBotAnswer(questionIndex);
+    }, 5000); // نفس فكرة الـ delay العشوائي بس رقم ثابت للاختبار
+
+    return () => clearTimeout(timer);
+    // نفس مصفوفة الاعتماديات بالظبط من الكود الحقيقي
+  }, [questionIndex, opponentAnswered, phase]);
+
+  return null;
+}
+
+function BotTimerFixed({ questionIndex, opponentAnswered, isBotMatch, onBotAnswer }) {
+  useEffect(() => {
+    if (!isBotMatch) return;
+    if (opponentAnswered) return;
+
+    const timer = setTimeout(() => {
+      onBotAnswer(questionIndex);
+    }, 5000);
+
+    return () => clearTimeout(timer);
+    // نفس الإصلاح الحقيقي في VsMatchPage.jsx: من غير phase في الشرط أو المصفوفة
+  }, [isBotMatch, questionIndex, opponentAnswered]);
+
+  return null;
+}
+
+describe('نمط مؤقّت إجابة البوت (إعادة إنتاج من VsMatchPage)', () => {
+  beforeEach(() => { vi.useFakeTimers(); });
+  afterEach(() => { vi.useRealTimers(); });
+
+  it('البوت بيجاوب لو محدش لمس الـ phase قبل ما المؤقّت يخلص', () => {
+    const onBotAnswer = vi.fn();
+    render(<BotTimerRepro phase="question" questionIndex={0} opponentAnswered={false} onBotAnswer={onBotAnswer} />);
+
+    act(() => { vi.advanceTimersByTime(5000); });
+
+    expect(onBotAnswer).toHaveBeenCalledWith(0);
+  });
+
+  it('🐛 لو الإنسان جاوب بسرعة (phase اتغيّر لـ waiting) قبل ما مؤقّت البوت يخلص، البوت مابيجاوبش أبداً — حتى لو استنينا لفترة طويلة بعد كده', () => {
+    const onBotAnswer = vi.fn();
+    const { rerender } = render(
+      <BotTimerRepro phase="question" questionIndex={0} opponentAnswered={false} onBotAnswer={onBotAnswer} />
+    );
+
+    // بعد ثانيتين بس (قبل الـ5 ثواني)، الإنسان جاوب — الـ phase بيتغيّر
+    act(() => { vi.advanceTimersByTime(2000); });
+    rerender(<BotTimerRepro phase="waiting" questionIndex={0} opponentAnswered={false} onBotAnswer={onBotAnswer} />);
+
+    // نستنى وقت طويل جداً كمان (30 ثانية) — لو المؤقّت كان لسه شغال كان
+    // المفروض يكون خلص من زمان. النتيجة: البوت أبداً ما بيجاوبش.
+    act(() => { vi.advanceTimersByTime(30000); });
+
+    expect(onBotAnswer).not.toHaveBeenCalled();
+  });
+
+  it('لو opponentAnswered=true من البداية (البوت جاوب فعلاً)، المؤقّت مايتجدولش أصلاً — سلوك متوقّع', () => {
+    const onBotAnswer = vi.fn();
+    render(<BotTimerRepro phase="question" questionIndex={0} opponentAnswered={true} onBotAnswer={onBotAnswer} />);
+    act(() => { vi.advanceTimersByTime(10000); });
+    expect(onBotAnswer).not.toHaveBeenCalled();
+  });
+
+  it('✅ بعد الإصلاح: نفس السيناريو (الإنسان جاوب بسرعة) — البوت لسه بيجاوب لأن المؤقّت مابقاش معتمد على phase', () => {
+    const onBotAnswer = vi.fn();
+    const { rerender } = render(
+      <BotTimerFixed questionIndex={0} opponentAnswered={false} isBotMatch={true} onBotAnswer={onBotAnswer} />
+    );
+
+    act(() => { vi.advanceTimersByTime(2000); });
+    // محاكاة تغييرات تانية غير متعلقة (زي phase) بتحصل من غير ما تلمس
+    // deps المؤقّت — مفروض المؤقّت يفضل شغال زي ما هو
+    rerender(<BotTimerFixed questionIndex={0} opponentAnswered={false} isBotMatch={true} onBotAnswer={onBotAnswer} />);
+
+    act(() => { vi.advanceTimersByTime(3000); }); // يوصل لـ 5000ms الإجمالي
+
+    expect(onBotAnswer).toHaveBeenCalledWith(0);
+  });
+});
